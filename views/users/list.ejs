<!DOCTYPE html>
<html lang="en">
<head>
    <title>Document</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body>

    <h1>Current Users</h1>

    <table class="table table-danger table-striped-columns table-hover">

        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Gender</th>
                <th>Age</th>
            </tr>
        </thead>

        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.firstName %></td>
                    <td><%= user.lastName %></td>
                    <td><%= user.gender %></td>
                    <td><%= user.age %></td>
                </tr>
            <% }) %>
        </tbody>

    </table>

</body>
</html>
